# Copy to .env.local (gitignored). Leave LLM_API_KEY empty to run with cached answers only.
# Groq (default):
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=
# Gemini instead:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
