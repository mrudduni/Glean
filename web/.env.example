# Copy to .env.local (gitignored). Leave LLM_API_KEY empty to run with cached answers only.
# Primary provider (Groq):
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# Optional fallback, tried once when the primary is rate-limited (429), fails (5xx) or times out.
# Gemini through its OpenAI-compatible endpoint:
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Users can bring their own key in the assistant drawer. By default it may only be sent to
# api.groq.com or generativelanguage.googleapis.com. Set to 1 to allow any https base URL.
ALLOW_CUSTOM_LLM_URL=
