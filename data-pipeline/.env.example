# Copy to data-pipeline/.env (gitignored) and fill in. Never commit the real file.

# NASA Earthdata Login (urs.earthdata.nasa.gov) — AppEEARS (MODIS, SMAP, ECOSTRESS, SRTM),
# GRACE (PO.DAAC) and IMERG (GES DISC). Also approve the "NASA GESDISC DATA ARCHIVE"
# application in your Earthdata profile for IMERG.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# USDA NASS QuickStats key (https://quickstats.nass.usda.gov/api) — yields, prices, acres
NASS_API_KEY=

# OpenET API key (https://etdata.org) — field and neighbour ET
OPENET_API_KEY=
